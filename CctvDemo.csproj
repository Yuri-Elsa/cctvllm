<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="tests/**" />
		<Content Remove="tests/**" />
		<EmbeddedResource Remove="tests/**" />
		<None Remove="tests/**" />
	</ItemGroup>
	<ItemGroup>
		<!-- Only needed with CCTV_SQLSERVER (found by name at run time). Pass -p:NoSqlClient=true to build without it. -->
		<PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" Condition="'$(NoSqlClient)' != 'true'" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="CctvDemo.Tests" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="activity-prompt.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="tracking/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Exclude="tracking/.config/**;tracking/__pycache__/**" />
	</ItemGroup>
</Project>