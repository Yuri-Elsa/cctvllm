<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CCTV Description Demo</title><link rel="icon" href="data:,"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous"><link rel="stylesheet" href="/style.css?v=f27b8c41d6a9"></head><body><div class="app-shell"><nav class="sidebar" aria-label="Main navigation"><a class="brand" href="#overview"><span class="brand-icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5A2.5 2.5 0 0 1 5.5 6h1.2a2 2 0 0 0 1.6-.8l.6-.9A2 2 0 0 1 10.6 3.5h2.8a2 2 0 0 1 1.7.8l.6.9a2 2 0 0 0 1.6.8h1.2A2.5 2.5 0 0 1 21 8.5v8A2.5 2.5 0 0 1 18.5 19h-13A2.5 2.5 0 0 1 3 16.5z"/><circle cx="12" cy="12.5" r="3.4"/></svg></span><span>CCTV <small>VIDEO REVIEW</small></span></a><div class="nav-caption">WORKSPACE</div><a class="nav-item active" href="#overview"><svg class="ico" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5" rx="1.8"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.8"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.8"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.8"/></svg> <span>Overview</span></a><a class="nav-item" href="#videoQueue"><svg class="ico" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13"/><circle cx="3.6" cy="6" r="1"/><circle cx="3.6" cy="12" r="1"/><circle cx="3.6" cy="18" r="1"/></svg> <span>Video queue</span></a><button class="nav-item" id="navCalibration"><svg class="ico" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9"/><path d="M12 3v9h9"/></svg> <span>Calibration</span></button><button class="nav-item" id="navSettings"><svg class="ico" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></svg> <span>Model settings</span></button><label class="side-cta" for="files">＋ Add videos</label>@await Html.PartialAsync("_AuthStatus")</nav><div class="workspace" id="overview">
<header><div><div class="eyebrow">SECURITY MONITORING</div><h1>Overview</h1><p class="subtitle">Video review & descriptions</p></div><div><span id="modelStatus"></span><button id="settingsButton">Settings</button></div></header>
<div class="section-caption"><span>SECTION 1: OVERVIEW</span></div>
<div class="summary-strip"><div class="stat stat-blue"><span class="stat-ico"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M3 9h18M3 15h18M8 4v16M16 4v16"/></svg></span><span class="metric-label">Videos</span><strong id="totalStat">0</strong><div class="stat-bar"><span class="track"><i id="barTotal"></i></span><b id="pctTotal">0%</b></div></div><div class="stat stat-green"><span class="stat-ico"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8.5 12.3 2.4 2.4 4.6-5"/></svg></span><span class="metric-label">Descriptions ready</span><strong id="readyStat">0</strong><div class="stat-bar"><span class="track"><i id="barReady"></i></span><b id="pctReady">0%</b></div></div><button class="stat stat-red" id="showFlagged" type="button" aria-pressed="false"><span class="stat-ico"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 21V4M5 4h11l-1.8 3.5L16 11H5"/></svg></span><span class="metric-label">Flagged for review ↗</span><strong id="flaggedStat">0</strong><div class="stat-bar"><span class="track"><i id="barFlagged"></i></span><b id="pctFlagged">0%</b></div></button><div class="stat stat-blue"><span class="stat-ico"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h4l2.5-6 4 12 2.5-6H21"/></svg></span><span class="metric-label">Queue status</span><strong id="runStat">Idle</strong><div class="stat-bar"><span class="track"><i id="barQueue"></i></span><b id="pctQueue">0%</b></div></div></div><div class="toolbar"><label id="dropzone" tabindex="0" role="button" aria-label="Add videos"><input type="file" id="files" accept="video/mp4,video/quicktime,video/webm,video/x-m4v" multiple hidden>＋ Add videos</label><button id="addFolder" type="button">＋ Add folder</button><input type="file" id="folder" webkitdirectory multiple hidden><span class="limits">Max 5 minutes · 500 MB per video</span><span id="uploadStatus" role="status"></span><button id="start" class="primary" disabled>Generate descriptions</button></div>
<details id="uploadErrors" hidden><summary id="uploadErrorSummary"></summary><ul id="uploadErrorList"></ul></details>
<div class="linkbar"><span class="linkbar-label">Linked folder</span><span id="linkedPath">None</span><button id="linkFolder" type="button">Link a folder</button><button id="refreshFolder" type="button" hidden>Refresh</button><button id="unlinkFolder" type="button" hidden>Unlink</button><span id="linkStatus" role="status"></span></div>
<section id="cameraPanel" class="camera-panel" aria-label="Camera status" hidden><div class="camera-panel-head"><h2>Cameras</h2><span id="cameraSummary" role="status"></span></div><div id="cameraList"></div></section>
<div class="section-caption"><span>SECTION 2: VIDEO REVIEW</span></div>
<main><aside id="videoQueue"><div class="heading"><h2>Videos <span id="count">0</span></h2><div class="queue-filters" role="group" aria-label="Filter videos"><button id="filterAll" type="button" aria-pressed="true">All videos</button><button id="filterFlagged" type="button" aria-pressed="false">Flagged</button><select id="cameraFilter" aria-label="Filter by camera" hidden><option value="all">All cameras</option></select></div></div><div id="queue"></div><div class="export-row" style="flex-wrap:wrap"><button id="selectAll" type="button">Select all</button><button id="deleteSelected" type="button" disabled>Delete selected (0)</button><button id="deleteAll" type="button">Delete all</button></div><div id="queueNote">One video at a time.</div><div class="export-row"><span>Export videos</span><button id="exportCsv" type="button">CSV</button><button id="exportJson" type="button">JSON</button></div></aside><section><div class="heading"><h2>Video review</h2><span id="status"></span></div><div id="detail"></div></section></main>
</div></div><dialog id="settings"><form id="settingsForm"><div class="modal-heading"><h2>Model settings</h2><button type="button" id="close" aria-label="Close settings">×</button></div><input type="hidden" id="mode" value="local"><label>Server URL<input id="endpoint" type="url" required></label><fieldset id="modelLabel"><legend>Model</legend><input type="hidden" id="model"><div id="modelChoices">Loading models…</div><button type="button" id="refreshModels">Refresh models</button></fieldset><label id="personLabelsLabel"><input type="checkbox" id="personLabels"> Person labels (YOLO)</label><fieldset class="screening-settings"><legend>Detection and thresholds</legend><label>Person detector<select id="personDetector"><option value="yolo">YOLO (default)</option><option value="hybrid">Hybrid (YOLO + LLM check)</option><option value="llm">LLM (vision model, slower)</option></select></label><label>Person threshold<input type="number" id="personThreshold" min="0" max="1" step="0.01"></label><label>Hybrid: check below (YOLO floor)<input type="number" id="personVerifyLow" min="0" max="1" step="0.01"></label><label>Hybrid: LLM threshold (p yes)<input type="number" id="hybridLlmThreshold" min="0" max="1" step="0.01"></label><label>Parallel LLM requests<input type="number" id="llmConcurrency" min="1" max="8" step="1"></label><label>Suspicious threshold (p yes)<input type="number" id="suspiciousThreshold" min="0" max="1" step="0.01"></label><label class="toggle-label"><input type="checkbox" id="agentEnabled"> Notification agent (Ollama mode)</label><p id="thresholdNote"></p></fieldset><label class="toggle-label"><input type="checkbox" id="batchProcessing"> Batch processing (faster hardware)</label><fieldset class="screening-settings"><legend>Screening</legend><label>Flag activity<textarea id="flagActivity" maxlength="4000" rows="3" placeholder="Leave blank to use the default criteria"></textarea></label><label class="toggle-label"><input type="checkbox" id="siteContextEnabled"> Site / camera context</label><textarea id="siteContext" aria-label="Site / camera context" maxlength="4000" rows="3" placeholder="Area, camera view, permitted activities…" disabled></textarea><label class="toggle-label"><input type="checkbox" id="weaponEnabled"> Weapon flag</label><p>Applies to new runs.</p></fieldset><fieldset class="screening-settings"><legend>Notifications</legend><button type="button" id="testNotify">Test notification</button><p id="testNotifyResult" role="status"></p></fieldset><fieldset class="screening-settings"><legend>System check</legend><button type="button" id="runPreflight">Run check</button> <span id="preflightStamp" role="status"></span><ul id="preflightList" class="preflight-list"></ul></fieldset><p id="settingsNote"></p><div id="settingsError" role="alert"></div><button class="primary" type="submit">Save</button></form></dialog>
<dialog id="calibration"><div class="modal-heading"><h2>Threshold calibration</h2><button type="button" id="calibrationClose" aria-label="Close calibration">×</button></div><p class="cal-intro">What would each suspicious threshold have caught on your own videos? It uses your review verdicts: Confirmed or False alarm on flagged videos, and Missed event or Normal on videos that were not flagged.</p><div class="cal-controls"><label>Camera<select id="calCamera"><option value="all">All cameras</option></select></label><label class="cal-check"><input type="checkbox" id="calAssume" checked><span>Count unreviewed, unflagged videos as normal</span></label><a id="calCsv" class="cal-csv" href="/api/calibration?format=csv" download>Download curve (CSV)</a></div><div id="calResults" aria-live="polite"></div></dialog><dialog id="linkDialog"><form id="linkForm"><div class="modal-heading"><h2>Link a video folder</h2><button type="button" id="linkClose" aria-label="Close">×</button></div><label>Folder path<input id="linkPath" type="text" spellcheck="false" autocomplete="off" placeholder="~/Videos/cctv" required></label><p>Paste the full path to the folder your videos are in. The app reads that folder directly, so Refresh picks up newly added videos without re-selecting anything. Videos stay where they are — nothing is copied.</p><div id="linkError" role="alert"></div><button class="primary" type="submit">Link folder</button></form></dialog>
<div id="toast" role="status" aria-live="polite"></div><script src="/app.js?v=d8a1f36b7e52"></script><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4" crossorigin="anonymous"></script></body></html>
